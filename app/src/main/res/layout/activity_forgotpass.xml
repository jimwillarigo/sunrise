<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="311dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/saycheese" />

    <EditText
        android:textColor="@color/black"
        android:fontFamily="@font/montserrat"
        android:background="@drawable/borderoutline"
        android:padding="10dp"
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/gray"
        android:hint="Enter username"
        android:inputType="text" />

    <Button
        android:id="@+id/btnSearch"
        android:fontFamily="@font/montserrat"
        android:background="@drawable/borderoutline"
        android:textColor="@color/black"
        android:layout_marginTop="5dp"
        android:backgroundTint="@color/autumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:drawableEnd="@drawable/searchicon"
        android:text="Search" />

    <TextView
        android:id="@+id/pleasesel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:inputType="text"
        android:textColor="@color/gray"
        android:fontFamily="@font/montserrat"
        android:visibility="gone"
        android:text="Select one of your images from your history"/>

    <TextView
        android:id="@+id/tapsearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="@color/gray"
        android:fontFamily="@font/montserrat"
        android:textStyle="italic"
        android:textSize="13dp"
        android:visibility="gone"
        android:text="If unsure, 'SEARCH' again to reshuffle the images"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border"
        android:layout_marginTop="5dp"
        android:visibility="visible"
        android:padding="5dp" />

    <ImageView
        android:visibility="gone"
        android:id="@+id/verifiedlogo"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="30dp"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:src="@drawable/verifiedlogo"/>



    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/borderoutline"
        android:textColor="@color/black"
        android:backgroundTint="@color/autumn"
        android:fontFamily="@font/montserrat"
        android:padding="10dp"
        android:text="Change password"
        android:visibility="gone" />


</LinearLayout>
