<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="311dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:src="@drawable/saycheese" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/all_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/borderoutline"
                android:backgroundTint="@color/autumn"
                android:drawableEnd="@drawable/sorticon"
                android:fontFamily="@font/montserrat"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/recoverhis"
                android:drawableEnd="@drawable/recovericon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/borderoutline"
                android:backgroundTint="@color/autumn"
                android:fontFamily="@font/montserrat"
                android:padding="5dp"
                android:text="Recover"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/delhisbutton"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/delicon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/borderoutline"
                android:backgroundTint="@color/autumn"
                android:fontFamily="@font/montserrat"
                android:padding="5dp"
                android:text="Clear"
                android:textColor="@color/black" />

        </LinearLayout>
        <TextView
            android:id="@+id/hisindicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/montserrat"
            android:textSize="20dp"
            android:layout_marginLeft="10dp"
            android:text="History"/>


        <LinearLayout
            android:id="@+id/listviewbg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ListView
                android:id="@+id/history_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <TextView
                android:id="@+id/my_text_view_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TextView" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginBottom="10dp"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:background="@drawable/borderoutline"
                android:backgroundTint="@color/autumn"
                android:fontFamily="@font/montserrat"
                android:layout_gravity="center"
                android:text="Previous"
                android:textAllCaps="false"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/pagecounter"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:textSize="20dp"
                android:textColor="@color/black"
                android:fontFamily="@font/montserrat"
                android:background="@drawable/borderoutline"
                android:text="1"/>

            <Button
                android:id="@+id/btnNext"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/borderoutline"
                android:backgroundTint="@color/autumn"
                android:fontFamily="@font/montserrat"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
